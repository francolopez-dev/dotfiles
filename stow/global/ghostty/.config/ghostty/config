# Ghostty - global terminal config tracked by dotfiles.
# Shared across every machine. Put machine-specific font overrides in profiles.

# --- Theme ---
theme = Catppuccin Mocha
minimum-contrast = 1.2
palette-generate = true

# --- Font ---
font-family = JetBrains Mono
font-family = FiraCode Nerd Font
font-size = 13
font-thicken = false
font-feature = -calt

# --- Window ---
gtk-wide-tabs = false
window-padding-x = 18
window-padding-y = 14
background-opacity = 0.92
background-blur = true
background-opacity-cells = true
unfocused-split-opacity = 0.9

# --- Behavior ---
scrollback-limit = 10000
confirm-close-surface = false
shell-integration = detect
shell-integration-features = cursor,sudo,title
bold-is-bright = true
mouse-hide-while-typing = true
cursor-click-to-move = true
selection-clear-on-copy = true

# --- Cursor ---
cursor-style = bar
cursor-style-blink = false
cursor-color = cell-foreground
cursor-text = cell-background
adjust-cursor-thickness = 35%

# --- Keybinds (Super = Win/macOS Command on Omarchy/Hyprland) ---
keybind = super+c=copy_to_clipboard
keybind = super+v=paste_from_clipboard
keybind = super+a=select_all
keybind = super+t=new_tab
keybind = super+w=close_surface
keybind = super+q=quit
keybind = ctrl+tab=next_tab
keybind = ctrl+shift+tab=previous_tab

# Optional profile layer override. This wins over global font settings.
config-file = ?~/.config/ghostty/profile-overrides
