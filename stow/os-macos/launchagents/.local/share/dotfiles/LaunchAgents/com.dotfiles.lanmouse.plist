<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.dotfiles.lanmouse</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>-lc</string>
    <string>mkdir -p "$HOME/Library/Logs/dotfiles"; exec "/Applications/Lan Mouse.app/Contents/MacOS/lan-mouse" daemon >>"$HOME/Library/Logs/dotfiles/lanmouse.out.log" 2>>"$HOME/Library/Logs/dotfiles/lanmouse.err.log"</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ProcessType</key>
  <string>Interactive</string>
</dict>
</plist>
