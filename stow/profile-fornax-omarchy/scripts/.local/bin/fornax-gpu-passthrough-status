#!/usr/bin/env bash
set -euo pipefail

devices=(0000:02:00.0 0000:02:00.1)

printf 'FORNAX NVIDIA passthrough status\n\n'
for dev in "${devices[@]}"; do
  sys="/sys/bus/pci/devices/$dev"
  if [[ ! -e "$sys" ]]; then
    printf 'warn %s not found\n' "$dev"
    continue
  fi
  driver="$(basename "$(readlink -f "$sys/driver" 2>/dev/null || printf 'none')")"
  group="$(basename "$(readlink -f "$sys/iommu_group" 2>/dev/null || printf 'unknown')")"
  vendor="$(<"$sys/vendor")"
  device="$(<"$sys/device")"
  printf '%s vendor:device=%s:%s driver=%s iommu_group=%s\n' "$dev" "${vendor#0x}" "${device#0x}" "$driver" "$group"
done

printf '\nExpected passthrough IDs: vfio-pci.ids=10de:2c59,10de:22e9\n'
printf 'Safe default: keep NVIDIA bound to Linux unless booted into an explicit VFIO mode.\n'
