#!/usr/bin/env bash
set -euo pipefail

NOTES_DIR="$HOME/Documents/Notes"
INBOX_DIR="$NOTES_DIR/inbox"

ensure_notes() {
  mkdir -p "$INBOX_DIR" "$NOTES_DIR/archive" "$NOTES_DIR/projects" "$NOTES_DIR/daily"
  [ -f "$NOTES_DIR/inbox.md" ] || : >"$NOTES_DIR/inbox.md"
}

prompt_title() {
  printf 'New note title: ' >&2
  IFS= read -r title
  printf '%s\n' "$title"
}

slugify() {
  tr '[:upper:]' '[:lower:]' |
    tr -cs '[:alnum:]' '-' |
    sed 's/^-\+//; s/-\+$//; s/-\+/-/g'
}

unique_path() {
  local base="$1" ext="$2" path n
  path="$INBOX_DIR/$base$ext"
  if [ ! -e "$path" ]; then
    printf '%s\n' "$path"
    return 0
  fi

  n=2
  while [ -e "$INBOX_DIR/$base-$n$ext" ]; do
    n=$((n + 1))
  done
  printf '%s\n' "$INBOX_DIR/$base-$n$ext"
}

ensure_notes
title="$(prompt_title | tr -d '\r')"
title="${title//$'\n'/ }"
[ -n "$title" ] || exit 0

slug="$(printf '%s' "$title" | slugify)"
[ -n "$slug" ] || slug="note"

date_prefix="$(date +%F)"
file="$(unique_path "$date_prefix-$slug" '.md')"

{
  printf '# %s\n\n' "$title"
} >"$file"

omarchy-notes open "$file"
