# ============================================================
# Secrets & machine-local artifacts must NEVER be committed.
# ============================================================

# Machine-specific config (env.local, *.local, ssh config.local, etc.).
# Keep stow-managed XDG .local trees trackable.
*.local
!stow/**/.local/
!stow/**/.local/**

# Per-machine profile state
.config/dotfiles/profile
stow/global/neovim/.config/nvim/lazy-lock.json

# Recovery pack working dir & encrypted artifacts (Phase 2)
/recovery-pack/
/recovery/
/recovery.local
/recovery.local.*
/.config/dotfiles/recovery.local
/.config/dotfiles/recovery.local.*
/.local/state/dotfiles/recovery/
/.msmtprc
*.tar.gz.age
*.age

# TLS/key material (e.g. lan-mouse.pem) must never be committed.
*.pem

# SSH key material must never be committed. Only the ssh client config is
# trackable under any stow ssh package; keys, authorized_keys, and known_hosts
# stay machine-local (legacy checkouts accumulated them untracked in-repo).
stow/**/.ssh/*
!stow/**/.ssh/config

# Logs
logs/
*.log
.cache/

# Test scratch worktrees
/tests/**/.tmp/
/tests/**/.tmp/**

# OS cruft
.DS_Store
._*
Thumbs.db
*.swp
*~
.thumbnails/
local-wallpapers/
**/raycast/
.ollama/
*.plist.bak
