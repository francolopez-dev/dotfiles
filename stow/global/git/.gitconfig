[user]
	name = Franco
	email = jfranco8@outlook.com
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
[core]
  excludesfile = ~/.gitignore_global
# Machine-local overrides, loaded last so they win. Untracked; git skips the
# include silently when the file does not exist. On work servers set the work
# identity there so the personal identity above never lands in work commits:
#   git config --file ~/.gitconfig.local user.email "you@company.com"
[include]
	path = ~/.gitconfig.local

