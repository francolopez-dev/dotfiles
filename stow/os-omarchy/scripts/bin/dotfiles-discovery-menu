#!/usr/bin/env bash
set -euo pipefail

PATH="$HOME/.local/bin:$HOME/bin:/usr/local/bin:/usr/bin:/bin:${PATH:-}"

script_path="$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null || printf '%s\n' "${BASH_SOURCE[0]}")"
repo_dir="${DOTFILES_DIR:-}"
if [[ -z "$repo_dir" ]]; then
  repo_dir="$(cd "$(dirname "$script_path")/../../../.." 2>/dev/null && pwd || true)"
fi
registry="${XDG_CONFIG_HOME:-$HOME/.config}/dotfiles/commands.tsv"
if [[ -n "$repo_dir" && -f "$repo_dir/stow/global/discovery/.config/dotfiles/commands.tsv" ]]; then
  registry="$repo_dir/stow/global/discovery/.config/dotfiles/commands.tsv"
fi

dotfiles_entries() {
  [[ -f "$registry" ]] || return 0
  awk -F '\t' 'NR > 1 && NF >= 9 { printf "%-34s %-24s %s\n", $4, $5, $7 }' "$registry"
}

menu_entries() {
  dotfiles_entries
  printf '\n'
  if command -v omarchy-menu-keybindings >/dev/null 2>&1; then
    omarchy-menu-keybindings --print || true
  fi
}

if [[ "${1:-}" == "--print" ]]; then
  menu_entries
  exit 0
fi

height=300
if command -v hyprctl >/dev/null 2>&1 && command -v jq >/dev/null 2>&1; then
  monitor_height="$(hyprctl monitors -j 2>/dev/null | jq -r '.[] | select(.focused == true) | .height' 2>/dev/null || true)"
  if [[ "$monitor_height" =~ ^[0-9]+$ && "$monitor_height" -gt 0 ]]; then
    height=$((monitor_height * 45 / 100))
  fi
fi

menu_entries | walker --dmenu -p 'Keybindings and Dotfiles' --width 900 --height "$height"
