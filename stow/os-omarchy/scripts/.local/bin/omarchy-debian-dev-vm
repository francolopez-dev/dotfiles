#!/usr/bin/env bash
set -euo pipefail

vm_name="debian-dev"
memory="8192"
vcpus="8"
disk_size="80"
iso_path=""
storage_root="${XDG_DATA_HOME:-$HOME/.local/share}/libvirt/dev-vms"
start_install=0

usage() {
  cat <<'EOF'
Usage: omarchy-debian-dev-vm [options]

Create a normal non-raw Debian development VM on qemu:///system.

Options:
  --name NAME       VM name (default: debian-dev)
  --iso PATH        Debian installer ISO path (required unless --print-defaults)
  --memory MB       RAM in MiB (default: 8192)
  --vcpus COUNT     vCPU count (default: 8)
  --disk-size GB    qcow2 disk size in GiB (default: 80)
  --storage-root DIR
                   VM storage root (default: ~/.local/share/libvirt/dev-vms)
  --start-install   Launch installer immediately after defining the VM
  --print-defaults  Show defaults and exit
  -h, --help        Show this help

Example:
  omarchy-debian-dev-vm --iso ~/VMs/iso/debian-12.6.0-amd64-netinst.iso --start-install
EOF
}

info() { printf '==> %s\n' "$*"; }
die() { printf 'err %s\n' "$*" >&2; exit 1; }

require_cmd() {
  command -v "$1" >/dev/null 2>&1 || die "missing command: $1"
}

print_defaults() {
  cat <<EOF
name=$vm_name
memory=$memory
vcpus=$vcpus
disk_size=$disk_size
storage_root=$storage_root
connection=qemu:///system
network=default
EOF
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --name) vm_name="${2:-}"; shift ;;
    --iso) iso_path="${2:-}"; shift ;;
    --memory) memory="${2:-}"; shift ;;
    --vcpus) vcpus="${2:-}"; shift ;;
    --disk-size) disk_size="${2:-}"; shift ;;
    --storage-root) storage_root="${2:-}"; shift ;;
    --start-install) start_install=1 ;;
    --print-defaults) print_defaults; exit 0 ;;
    -h|--help) usage; exit 0 ;;
    *) die "unknown argument: $1" ;;
  esac
  shift
done

[[ -n "$vm_name" ]] || die "--name cannot be empty"
[[ "$memory" =~ ^[0-9]+$ ]] || die "--memory must be numeric MiB"
[[ "$vcpus" =~ ^[0-9]+$ ]] || die "--vcpus must be numeric"
[[ "$disk_size" =~ ^[0-9]+$ ]] || die "--disk-size must be numeric GiB"
[[ -n "$iso_path" ]] || die "--iso is required"
[[ -f "$iso_path" ]] || die "ISO not found: $iso_path"

require_cmd virsh
require_cmd virt-install

if virsh -c qemu:///system dominfo "$vm_name" >/dev/null 2>&1; then
  die "VM already exists: $vm_name"
fi

if ! virsh -c qemu:///system net-info default >/dev/null 2>&1; then
  die "default libvirt network is unavailable; enable libvirt and default NAT first"
fi

mkdir -p "$storage_root/disks"
disk_path="$storage_root/disks/$vm_name.qcow2"
[[ ! -e "$disk_path" ]] || die "disk already exists: $disk_path"

args=()
args+=(--connect qemu:///system)
args+=(--name "$vm_name")
args+=(--memory "$memory")
args+=(--vcpus "$vcpus")
args+=(--cpu host-passthrough)
args+=(--disk "path=$disk_path,size=$disk_size,bus=virtio,format=qcow2")
args+=(--cdrom "$iso_path")
args+=(--os-variant debian12)
args+=(--network "network=default,model=virtio")
args+=(--graphics spice)
args+=(--video virtio)
args+=(--boot uefi)

if [[ "$start_install" -eq 0 ]]; then
  args+=(--noautoconsole)
fi

info "Creating Debian development VM: $vm_name"
virt-install "${args[@]}"

if [[ "$start_install" -eq 0 ]]; then
  info "Defined $vm_name. Start the installer with: virt-viewer -c qemu:///system $vm_name"
fi
