#!/usr/bin/env bash
set -euo pipefail

user_name="${SUDO_USER:-$USER}"

info() { printf '==> %s\n' "$*"; }
warn() { printf 'warn %s\n' "$*" >&2; }
die() { printf 'err %s\n' "$*" >&2; exit 1; }

require_cmd() {
  command -v "$1" >/dev/null 2>&1 || die "missing command: $1"
}

require_cmd sudo
require_cmd systemctl
require_cmd virsh
require_cmd usermod

ensure_ufw_libvirt_rules() {
  command -v ufw >/dev/null 2>&1 || return 0
  sudo ufw status 2>/dev/null | grep -q '^Status: active' || return 0

  info "Allowing default libvirt NAT network through ufw"
  sudo ufw allow in on virbr0 comment 'libvirt default network' >/dev/null
  sudo ufw route allow in on virbr0 comment 'libvirt guest forwarding' >/dev/null
}

info "Enabling libvirtd.service"
sudo systemctl enable --now libvirtd.service

if id -nG "$user_name" | tr ' ' '\n' | grep -qx libvirt; then
  info "$user_name is already in the libvirt group"
else
  info "Adding $user_name to the libvirt group"
  sudo usermod -aG libvirt "$user_name"
  warn "Log out or reboot for libvirt group membership to apply."
fi

if ! sudo virsh -c qemu:///system net-info default >/dev/null 2>&1; then
  info "Defining default libvirt NAT network"
  tmp="$(mktemp)"
  trap 'rm -f "$tmp"' EXIT
  cat >"$tmp" <<'XML'
<network>
  <name>default</name>
  <forward mode='nat'/>
  <bridge name='virbr0' stp='on' delay='0'/>
  <ip address='192.168.122.1' netmask='255.255.255.0'>
    <dhcp>
      <range start='192.168.122.2' end='192.168.122.254'/>
    </dhcp>
  </ip>
</network>
XML
  sudo virsh -c qemu:///system net-define "$tmp"
fi

info "Starting default libvirt NAT network"
sudo virsh -c qemu:///system net-start default >/dev/null 2>&1 || true

info "Enabling default libvirt NAT network autostart"
sudo virsh -c qemu:///system net-autostart default

ensure_ufw_libvirt_rules

info "Current libvirt networks"
sudo virsh -c qemu:///system net-list --all

info "Done. Log out or reboot if this command added your user to the libvirt group."
