#!/usr/bin/env bash
set -euo pipefail

connection="qemu:///system"
default_name="windows"
storage_root="${XDG_DATA_HOME:-$HOME/.local/share}/libvirt/windows-vms"
confirm_phrase="I understand this can destroy data"

info() { printf '==> %s\n' "$*"; }
warn() { printf 'warn %s\n' "$*" >&2; }
die() { printf 'err %s\n' "$*" >&2; exit 1; }

require_cmd() {
  command -v "$1" >/dev/null 2>&1 || die "missing command: $1"
}

prompt() {
  local label="$1" default="${2:-}" value
  if [[ -n "$default" ]]; then
    read -r -p "$label [$default]: " value
    printf '%s\n' "${value:-$default}"
  else
    read -r -p "$label: " value
    printf '%s\n' "$value"
  fi
}

prompt_number() {
  local label="$1" default="$2" value
  while true; do
    value="$(prompt "$label" "$default")"
    [[ "$value" =~ ^[0-9]+$ ]] && [[ "$value" -gt 0 ]] && { printf '%s\n' "$value"; return; }
    warn "$label must be a positive integer"
  done
}

prompt_file() {
  local label="$1" value
  while true; do
    value="$(prompt "$label")"
    [[ -n "$value" ]] || { warn "path cannot be empty"; continue; }
    value="${value/#\~/$HOME}"
    [[ -f "$value" ]] && { printf '%s\n' "$value"; return; }
    warn "file not found: $value"
  done
}

require_cmd virsh
require_cmd virt-install
require_cmd lsblk

windows_os_variant="win10"
if command -v osinfo-query >/dev/null 2>&1; then
  windows_os_variant="$(osinfo-query os 2>/dev/null | awk '/win11/ { print $1; found=1; exit } END { if (!found) exit 1 }' || printf 'win10')"
fi

cat <<'EOF'
This wizard creates a Windows VM on system libvirt.

It can create a local qcow2 disk image or attach a raw block device that you
explicitly choose. Raw disk mode is dangerous and is never selected
automatically.

This wizard does not mount NTFS, edit fstab, change bootloaders, configure GPU
assignment, or modify an existing Windows install unless you explicitly choose
raw disk mode and then boot that disk in the VM.
EOF

vm_name="$(prompt "VM name" "$default_name")"
[[ -n "$vm_name" ]] || die "VM name cannot be empty"

if virsh -c "$connection" dominfo "$vm_name" >/dev/null 2>&1; then
  die "VM already exists: $vm_name"
fi

windows_iso="$(prompt_file "Windows ISO path")"
ram_gb="$(prompt_number "RAM in GB" 8)"
vcpus="$(prompt_number "vCPUs" 4)"
memory_mib=$((ram_gb * 1024))

printf '\nStorage mode:\n'
printf '  1) Local qcow2 image\n'
printf '  2) Raw block device / dedicated disk\n'
while true; do
  storage_choice="$(prompt "Choose storage mode" 1)"
  case "$storage_choice" in
    1) storage_mode="qcow2"; break ;;
    2) storage_mode="raw"; break ;;
    *) warn "choose 1 or 2" ;;
  esac
done

disk_arg=""
if [[ "$storage_mode" == "qcow2" ]]; then
  disk_size_gb="$(prompt_number "Disk size in GB" 100)"
  mkdir -p "$storage_root/disks"
  disk_path="$storage_root/disks/$vm_name.qcow2"
  [[ ! -e "$disk_path" ]] || die "disk already exists: $disk_path"
  disk_arg="path=$disk_path,size=$disk_size_gb,bus=virtio,format=qcow2,cache=none,discard=unmap"
else
  printf '\nDetected block devices:\n'
  lsblk -o NAME,SIZE,TYPE,FSTYPE,LABEL,MOUNTPOINTS
  cat <<EOF

Raw disk mode can destroy data if you choose the wrong device.
Use a stable /dev/disk/by-id/... path, not /dev/nvme0n1 or /dev/sdX.
Required confirmation phrase: $confirm_phrase
EOF
  while true; do
    raw_path="$(prompt "Raw disk /dev/disk/by-id path")"
    [[ "$raw_path" == /dev/disk/by-id/* ]] || { warn "path must start with /dev/disk/by-id/"; continue; }
    [[ -e "$raw_path" ]] || { warn "path does not exist: $raw_path"; continue; }
    break
  done
  confirmation="$(prompt "Type confirmation phrase exactly")"
  [[ "$confirmation" == "$confirm_phrase" ]] || die "confirmation phrase did not match; aborting"
  disk_arg="path=$raw_path,bus=virtio,format=raw,cache=none,discard=unmap"
fi

virtio_iso=""
attach_virtio="$(prompt "Attach VirtIO driver ISO?" "n")"
case "$attach_virtio" in
  y|Y|yes|YES) virtio_iso="$(prompt_file "VirtIO ISO path")" ;;
esac

start_install="$(prompt "Start installer now?" "y")"

args=()
args+=(--connect "$connection")
args+=(--name "$vm_name")
args+=(--memory "$memory_mib")
args+=(--vcpus "$vcpus")
args+=(--cpu host-passthrough)
args+=(--disk "$disk_arg")
args+=(--cdrom "$windows_iso")
args+=(--os-variant "$windows_os_variant")
args+=(--network "network=default,model=virtio")
args+=(--graphics "spice,listen=none")
args+=(--video qxl)
args+=(--controller "type=scsi,model=virtio-scsi")
args+=(--input "tablet,bus=usb")
args+=(--boot uefi)
args+=(--tpm "backend.type=emulator,backend.version=2.0,model=tpm-crb")

if [[ -n "$virtio_iso" ]]; then
  args+=(--disk "path=$virtio_iso,device=cdrom,readonly=on")
fi

case "$start_install" in
  n|N|no|NO) args+=(--noautoconsole) ;;
esac

info "Creating Windows VM: $vm_name"
virt-install "${args[@]}"

cat <<EOF

Next steps:
- Install Windows from the ISO.
- If Windows has no network, temporarily switch NIC to e1000e in virt-manager or attach/install VirtIO NetKVM drivers.
- Install SPICE guest tools inside Windows for clipboard, mouse, and resize behavior.
- After Windows enables RDP, run: omarchy-windows-vm rdp $vm_name
- Manual edits: virt-manager -c $connection
EOF
