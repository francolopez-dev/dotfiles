#!/usr/bin/env bash
set -euo pipefail

windows_disk="/dev/disk/by-id/nvme-WD_PC_SN8000S_SDEPNRK-1T00-1101_25100E4A5Y08"
packages=(qemu-full libvirt virt-manager edk2-ovmf swtpm dnsmasq iptables virt-viewer virt-install guestfs-tools spice-vdagent dmidecode)

section() { printf '\n==> %s\n' "$*"; }
ok() { printf ' ok  %s\n' "$*"; }
warn() { printf 'warn %s\n' "$*"; }

section "FORNAX virtualization status"
printf 'host: %s\n' "$(hostname -s 2>/dev/null || hostname)"
uri="$(virsh uri 2>/dev/null || true)"
printf 'libvirt default URI: %s\n' "${uri:-unavailable}"

section "Packages"
missing=0
for pkg in "${packages[@]}"; do
  if pacman -Q "$pkg" >/dev/null 2>&1; then
    ok "$pkg"
  else
    warn "missing: $pkg"
    missing=1
  fi
done

section "Service and access"
if systemctl is-enabled libvirtd.service >/dev/null 2>&1; then
  ok "libvirtd enabled"
else
  warn "libvirtd not enabled"
fi
if systemctl is-active libvirtd.service >/dev/null 2>&1; then
  ok "libvirtd active"
else
  warn "libvirtd not active"
fi
if id -nG "$USER" | tr ' ' '\n' | grep -qx libvirt; then
  ok "$USER is in libvirt group"
else
  warn "$USER is not in libvirt group; run fornax-libvirt-setup, then log out or reboot"
fi

section "Default network"
if virsh -c qemu:///system net-info default >/dev/null 2>&1; then
  virsh -c qemu:///system net-list --all
else
  warn "default libvirt network is not defined or qemu:///system is unavailable"
fi

section "Windows raw NVMe disk"
if [[ -e "$windows_disk" ]]; then
  resolved="$(readlink -f "$windows_disk")"
  ok "$windows_disk -> $resolved"
  lsblk -o NAME,SIZE,FSTYPE,LABEL,UUID,MOUNTPOINTS "$resolved"
  if lsblk -nr -o FSTYPE,MOUNTPOINTS "$resolved" | awk '$1 ~ /^(ntfs|vfat)$/ && $2 != "" { found=1 } END { exit found ? 0 : 1 }'; then
    warn "one or more Windows disk partitions are mounted; do not start the raw-disk VM"
  else
    ok "no mounted ntfs/vfat partitions found on Windows disk"
  fi
else
  warn "Windows disk path missing: $windows_disk"
fi

section "NVIDIA passthrough candidate"
for dev in 0000:02:00.0 0000:02:00.1; do
  if [[ -e "/sys/bus/pci/devices/$dev" ]]; then
    driver="$(basename "$(readlink -f "/sys/bus/pci/devices/$dev/driver" 2>/dev/null || printf 'none')")"
    group="$(basename "$(readlink -f "/sys/bus/pci/devices/$dev/iommu_group" 2>/dev/null || printf 'unknown')")"
    printf '%s driver=%s iommu_group=%s\n' "$dev" "$driver" "$group"
  else
    warn "$dev not found"
  fi
done

exit "$missing"
