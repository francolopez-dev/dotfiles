#!/usr/bin/env bash
set -euo pipefail

vm_name="windows-raw-nvme"
windows_disk="/dev/disk/by-id/nvme-WD_PC_SN8000S_SDEPNRK-1T00-1101_25100E4A5Y08"
with_nvidia=0

usage() {
  cat <<'EOF'
Usage: fornax-windows-raw-nvme-define [--with-nvidia]

Defines the FORNAX Windows raw NVMe libvirt VM against qemu:///system.

Without --with-nvidia, the VM uses virtual graphics. With --with-nvidia, the
script also attaches the NVIDIA GPU/audio pair, but only if both devices are
already bound to vfio-pci.
EOF
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --with-nvidia) with_nvidia=1 ;;
    -h|--help) usage; exit 0 ;;
    *) printf 'unknown argument: %s\n' "$1" >&2; usage >&2; exit 1 ;;
  esac
  shift
done

info() { printf '==> %s\n' "$*"; }
warn() { printf 'warn %s\n' "$*" >&2; }
die() { printf 'err %s\n' "$*" >&2; exit 1; }

require_cmd() {
  command -v "$1" >/dev/null 2>&1 || die "missing command: $1"
}

driver_for() {
  basename "$(readlink -f "/sys/bus/pci/devices/$1/driver" 2>/dev/null || printf 'none')"
}

require_cmd readlink
require_cmd lsblk
require_cmd findmnt
require_cmd virsh
require_cmd virt-install

[[ -e "$windows_disk" ]] || die "Windows disk path not found: $windows_disk"
resolved_disk="$(readlink -f "$windows_disk")"
[[ -b "$resolved_disk" ]] || die "resolved Windows disk is not a block device: $resolved_disk"

if virsh -c qemu:///system dominfo "$vm_name" >/dev/null 2>&1; then
  die "VM already exists: $vm_name"
fi

if lsblk -nr -o MOUNTPOINTS "$resolved_disk" | awk '$0 != "" { found=1 } END { exit found ? 0 : 1 }'; then
  die "the Windows disk or one of its partitions is mounted; unmount it before defining/running this VM"
fi

root_source="$(findmnt -no SOURCE / 2>/dev/null || true)"
if [[ -n "$root_source" && "$(readlink -f "$root_source" 2>/dev/null || true)" == "$resolved_disk" ]]; then
  die "refusing to use the Linux root disk as a raw VM disk"
fi

extra_args=()
if [[ "$with_nvidia" -eq 1 ]]; then
  for dev in 0000:02:00.0 0000:02:00.1; do
    [[ -e "/sys/bus/pci/devices/$dev" ]] || die "NVIDIA PCI device missing: $dev"
    [[ "$(driver_for "$dev")" == "vfio-pci" ]] || die "$dev is not bound to vfio-pci; current driver: $(driver_for "$dev")"
  done
  extra_args+=(--hostdev 0000:02:00.0 --hostdev 0000:02:00.1)
fi

cat <<EOF
About to define VM: $vm_name
Windows disk: $windows_disk -> $resolved_disk
NVIDIA passthrough: $([[ "$with_nvidia" -eq 1 ]] && printf yes || printf no)

Before continuing, confirm:
- Windows Fast Startup is disabled.
- Windows was fully shut down, not hibernated.
- The Windows partitions are not mounted in Linux.
- Important Windows data is backed up.
EOF

printf 'Type DEFINE to continue: '
IFS= read -r answer
[[ "$answer" == "DEFINE" ]] || die "cancelled"

info "Defining $vm_name"
virt-install \
  --connect qemu:///system \
  --name "$vm_name" \
  --memory 16384 \
  --vcpus 12 \
  --cpu host-passthrough \
  --import \
  --disk "path=$windows_disk,bus=sata,format=raw,cache=none,io=native" \
  --os-variant win11 \
  --network network=default,model=virtio \
  --graphics spice \
  --video virtio \
  --boot uefi \
  --features smm=on \
  --tpm backend.type=emulator,backend.version=2.0,model=tpm-crb \
  "${extra_args[@]}" \
  --noautoconsole

info "Defined $vm_name. Open it with: virt-manager -c qemu:///system"
