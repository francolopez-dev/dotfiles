#!/usr/bin/env bash
set -euo pipefail

compose_file="${WINDOWS_DOCKURR_COMPOSE_FILE:-$HOME/.config/windows/docker-compose.yml}"

die() { printf 'err %s\n' "$*" >&2; exit 1; }
info() { printf '==> %s\n' "$*"; }

require_cmd() {
  command -v "$1" >/dev/null 2>&1 || die "missing command: $1"
}

host_ram_gib() {
  awk '/MemTotal:/ { printf "%d\n", $2 / 1024 / 1024 }' /proc/meminfo
}

target_cores() {
  local total="$1" cores
  cores=$((total / 2))
  (( cores < 4 )) && cores=4
  (( total <= 8 && cores > total - 2 )) && cores=$((total - 2))
  (( total > 8 && cores > total - 4 )) && cores=$((total - 4))
  (( cores < 1 )) && cores=1
  printf '%s\n' "$cores"
}

target_ram() {
  local total_gib="$1" ram
  ram=$((total_gib / 3))
  (( ram < 8 && total_gib >= 14 )) && ram=8
  (( ram > 16 )) && ram=16
  while (( total_gib - ram < 6 && ram > 2 )); do
    ram=$((ram - 1))
  done
  printf '%sG\n' "$ram"
}

[[ -f $compose_file ]] || die "compose file not found: $compose_file"
require_cmd docker

docker compose -f "$compose_file" config >/dev/null || die "compose file is malformed: $compose_file"

if ! grep -Eq '^[[:space:]]*-[[:space:]]*.*/\.windows:/storage' "$compose_file" && \
   ! grep -Eq 'source:[[:space:]]*.*/\.windows' "$compose_file"; then
  die "storage mount is unclear; refusing to edit $compose_file"
fi

total_cores=$(nproc)
total_ram_gib=$(host_ram_gib)
new_cores=$(target_cores "$total_cores")
new_ram=$(target_ram "$total_ram_gib")
timestamp=$(date +%Y%m%d-%H%M%S)
backup="$compose_file.bak.$timestamp"

cp "$compose_file" "$backup"

tmp=$(mktemp)
awk -v cores="$new_cores" -v ram="$new_ram" '
  $1 == "CPU_CORES:" { indent=substr($0, 1, index($0, $1)-1); print indent "CPU_CORES: \"" cores "\""; next }
  $1 == "RAM_SIZE:" { indent=substr($0, 1, index($0, $1)-1); print indent "RAM_SIZE: \"" ram "\""; next }
  { print }
' "$compose_file" >"$tmp"
mv "$tmp" "$compose_file"

docker compose -f "$compose_file" config >/dev/null || {
  cp "$backup" "$compose_file"
  die "edited compose did not validate; restored $backup"
}

info "host resources: ${total_cores} logical CPUs, ${total_ram_gib} GiB RAM"
info "set CPU_CORES=$new_cores and RAM_SIZE=$new_ram"
info "backup: $backup"
info "apply with: docker compose -f $compose_file up -d --no-deps windows"
