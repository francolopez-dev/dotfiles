{
  "reload_style_on_change": true,
  "layer": "top",
  "position": "top",
  "height": 28,
  "spacing": 0,
  "modules-left": ["custom/power", "custom/notes", "hyprland/workspaces", "hyprland/window"],
  "modules-center": ["custom/island"],
  "modules-right": ["tray", "cpu", "memory", "custom/gpu", "custom/vpn", "custom/ethernet", "custom/wifi", "bluetooth", "pulseaudio", "battery", "custom/date", "clock"],

  "custom/power": {
    "format": "󰐥",
    "tooltip-format": "System menu\nSuper + Alt + Space",
    "on-click": "omarchy-menu",
    "on-click-right": "xdg-terminal-exec"
  },

  "custom/notes": {
    "exec": "omarchy-notes status",
    "return-type": "json",
    "interval": 1,
    "tooltip": true,
    "on-click": "omarchy-notes toggle"
  },

  "hyprland/window": {
    "max-length": 36,
    "separate-outputs": true,
    "rewrite": {
      "(.*) — (.+)": "$2",
      "(.*) - (.+)": "$2"
    }
  },

  "hyprland/workspaces": {
    "on-click": "activate",
    "format": "{icon}",
    "format-icons": {
      "active": "",
      "default": ""
    },
    "persistent-workspaces": {
      "1": [],
      "2": [],
      "3": [],
      "4": [],
      "5": []
    }
  },

  "clock": {
    "format": "{:%I:%M %p}",
    "format-alt": "{:%H:%M}",
    "tooltip": false,
    "on-click-right": "omarchy-launch-floating-terminal-with-presentation omarchy-tz-select"
  },

  "custom/date": {
    "exec": "date '+%b%d'",
    "interval": 60,
    "tooltip": false
  },

  "custom/island": {
    "exec": "~/.config/waybar/scripts/island.sh",
    "return-type": "json",
    "interval": 2,
    "tooltip": true
  },

  "tray": {
    "icon-size": 13,
    "spacing": 9
  },

  "bluetooth": {
    "format": "",
    "format-connected": "󰂱 {num_connections}",
    "format-disabled": "󰂲",
    "format-off": "󰂲",
    "format-no-controller": "",
    "tooltip-format": "Bluetooth: {status}",
    "tooltip-format-connected": "{device_alias}",
    "on-click": "omarchy-launch-bluetooth"
  },

  "custom/wifi": {
    "exec": "~/.config/waybar/scripts/wifi.sh",
    "return-type": "json",
    "interval": 5,
    "tooltip": true,
    "on-click": "omarchy-launch-wifi"
  },

  "custom/ethernet": {
    "exec": "~/.config/waybar/scripts/ethernet.sh",
    "return-type": "json",
    "interval": 5,
    "tooltip": true
  },

  "custom/vpn": {
    "exec": "~/.config/waybar/scripts/vpn.sh",
    "return-type": "json",
    "interval": 10,
    "tooltip": true
  },

  "pulseaudio": {
    "scroll-step": 5,
    "format": "{icon} {volume}%",
    "format-muted": " muted",
    "states": {
      "high": 80,
      "danger": 95
    },
    "format-icons": {
      "headphone": "",
      "headset": "",
      "default": ["", "", ""]
    },
    "tooltip-format": "{desc}",
    "on-click": "omarchy-launch-audio",
    "on-click-right": "pamixer -t"
  },

  "cpu": {
    "interval": 3,
    "format": "󰍛 {usage}%",
    "tooltip": true,
    "on-click": "omarchy-launch-or-focus-tui btop",
    "on-click-right": "xdg-terminal-exec",
    "states": {
      "warm": 60,
      "hot": 85
    }
  },

  "memory": {
    "interval": 5,
    "format": "󰘚 {percentage}%",
    "tooltip-format": "Memory {used:0.1f}G / {total:0.1f}G",
    "on-click": "omarchy-launch-or-focus-tui btop",
    "states": {
      "warm": 70,
      "hot": 88
    }
  },

  "custom/gpu": {
    "exec": "~/.config/waybar/scripts/gpu.sh",
    "return-type": "json",
    "interval": 4,
    "tooltip": true,
    "on-click": "omarchy-launch-or-focus-tui btop",
    "on-click-right": "omarchy-launch-floating-terminal-with-presentation nvidia-smi"
  },

  "battery": {
    "interval": 5,
    "states": {
      "medium": 60,
      "warning": 30,
      "critical": 15
    },
    "format": "{icon} {capacity}%",
    "format-charging": "󰂄 {capacity}%",
    "format-plugged": " {capacity}%",
    "format-full": "󰂅 100%",
    "format-icons": ["󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
    "tooltip-format": "{timeTo}  {power}W",
    "on-click": "omarchy-menu power",
    "on-click-right": "notify-send -u low \"$(omarchy-battery-status)\""
  }
}
