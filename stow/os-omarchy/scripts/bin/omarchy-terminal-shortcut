#!/usr/bin/env bash
set -euo pipefail

action=${1:-}
window_json=$(hyprctl activewindow -j)
class=$(jq -r '.class // empty' <<<"$window_json")
address=$(jq -r '.address // empty' <<<"$window_json")

if [ -z "$action" ] || [ -z "$address" ]; then
  exit 0
fi

send_shortcut() {
  local mods="$1" key="$2"
  hyprctl dispatch "hl.dsp.send_key_state({mods=\"$mods\",key=\"$key\",state=\"down\"})"
  sleep 0.05
  hyprctl dispatch "hl.dsp.send_key_state({mods=\"$mods\",key=\"$key\",state=\"up\"})"
}

case "$action:$class" in
  select-all:com.mitchellh.ghostty|select-all:Alacritty)
    send_shortcut SUPER A
    ;;
  copy:com.mitchellh.ghostty|copy:Alacritty)
    send_shortcut SUPER C
    ;;
  paste:com.mitchellh.ghostty|paste:Alacritty)
    send_shortcut SUPER V
    ;;
  select-all:*)
    send_shortcut CTRL A
    ;;
  copy:*)
    send_shortcut CTRL Insert
    ;;
  paste:*)
    send_shortcut SHIFT Insert
    ;;
esac
