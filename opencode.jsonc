{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "lmstudio": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Fornax LM Studio",
      "options": {
        "baseURL": "http://100.98.153.75:1234/v1",
        "apiKey": "{env:LM_STUDIO_API_KEY}"
      },
      "models": {
        "qwen3-coder-30b-a3b-instruct": {
          "name": "Qwen3 Coder 30B - Coding"
        },
        "google/gemma-4-26b-a4b-qat": {
          "name": "Gemma 4 26B - General",
          "limit": {
            "context": 32768,
            "output": 4096
          }
        },
        "prism-ml/bonsai-27b": {
          "name": "Bonsai 27B - Reasoning"
        },
        "qwen/qwen3.5-9b": {
          "name": "Qwen 3.5 9B - Fast"
        },
        "google/gemma-4-e4b": {
          "name": "Gemma 4 E4B - Fast General"
        }
      }
    }
  },
  "model": "lmstudio/qwen3-coder-30b-a3b-instruct"
}
