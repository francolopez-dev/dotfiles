#!/usr/bin/env bash
set -euo pipefail

credentials_file="$HOME/.config/windows/credentials"
krb5_config="$HOME/.config/windows/krb5.conf"
omarchy_windows_vm=/usr/bin/omarchy-windows-vm

usage() {
  cat <<'EOF'
Usage: omarchy-windows-dockurr-rdp [launch|start] [--keep-alive]

Start the protected Omarchy Dockurr Windows container if needed and connect with
tuned FreeRDP settings for image quality and responsiveness.
EOF
}

die() { printf 'err %s\n' "$*" >&2; exit 1; }

require_cmd() {
  command -v "$1" >/dev/null 2>&1 || die "missing command: $1"
}

read_credential() {
  local wanted="$1" key value

  while IFS='=' read -r key value; do
    if [[ $key == "$wanted" ]]; then
      printf '%s' "$value"
      return 0
    fi
  done <"$credentials_file"

  return 1
}

rdp_scale_arg() {
  command -v hyprctl >/dev/null 2>&1 || return 0
  command -v jq >/dev/null 2>&1 || return 0

  local hypr_scale scale_percent
  hypr_scale=$(hyprctl monitors -j | jq -r '.[] | select(.focused == true) | .scale' 2>/dev/null || true)
  [[ -n $hypr_scale && $hypr_scale != "null" ]] || return 0

  scale_percent=$(awk -v scale="$hypr_scale" 'BEGIN { print int(scale * 100) }')
  if (( scale_percent >= 170 )); then
    printf '/scale:180\n'
  elif (( scale_percent >= 130 )); then
    printf '/scale:140\n'
  fi
}

rdp_ready() {
  local win_user="$1" win_pass="$2"

  printf '%s\n' \
    "/u:$win_user" \
    "/p:$win_pass" \
    '/v:127.0.0.1:3389' \
    '/auth-pkg-list:!kerberos' \
    '/cert:ignore' \
    '/auth-only' |
    timeout 10 xfreerdp3 /args-from:stdin >/dev/null 2>&1
}

wait_for_windows() {
  local win_user="$1" win_pass="$2" wait_count=0

  until rdp_ready "$win_user" "$win_pass"; do
    sleep 2
    wait_count=$((wait_count + 1))
    if (( wait_count > 150 )); then
      command -v notify-send >/dev/null 2>&1 &&
        notify-send -u critical "Windows VM" "RDP did not become ready within 5 minutes"
      die "timeout waiting for Windows RDP; check: $omarchy_windows_vm status"
    fi
  done
}

launch_windows() {
  local keep_alive=false
  case "${1:-}" in
    --keep-alive|-k) keep_alive=true ;;
    "") ;;
    *) die "unknown option: $1" ;;
  esac

  [[ -x $omarchy_windows_vm ]] || die "missing command: $omarchy_windows_vm"
  [[ -r $credentials_file ]] || die "credentials not found: $credentials_file"
  require_cmd pkexec
  require_cmd timeout
  require_cmd xfreerdp3

  local win_user win_pass rdp_scale
  win_user=$(read_credential USERNAME || true)
  win_pass=$(read_credential PASSWORD || true)
  [[ -n $win_user ]] || win_user="docker"
  [[ -n $win_pass ]] || win_pass="admin"

  mkdir -p "$(dirname "$krb5_config")"
  if [[ ! -f $krb5_config ]]; then
    printf '[libdefaults]\n  dns_lookup_kdc = false\n  dns_lookup_realm = false\n' >"$krb5_config"
  fi
  export KRB5_CONFIG="$krb5_config"

  if ! rdp_ready "$win_user" "$win_pass"; then
    printf 'Starting Windows VM...\n'
    if command -v notify-send >/dev/null 2>&1; then
      notify-send "Windows VM" "Starting Windows VM" -t 15000
    fi
    pkexec "$omarchy_windows_vm" __priv up || die "failed to start Windows VM"
    wait_for_windows "$win_user" "$win_pass"
  fi

  rdp_scale=$(rdp_scale_arg)

  rdp_args=(
    "/u:$win_user"
    "/p:$win_pass"
    "/v:127.0.0.1:3389"
    "/auth-pkg-list:!kerberos"
    "-grab-keyboard"
    "/sound"
    "/microphone"
    "/clipboard"
    "/cert:ignore"
    "/t:Windows VM - Omarchy"
    "+dynamic-resolution"
    "/bpp:32"
    "/network:auto"
    "/gfx:AVC444:on,AVC420:on,progressive:on,small-cache:on,frame-ack:on"
    "/cache:bitmap:on,glyph:on,offscreen:on,persist"
    "+aero"
    "+window-drag"
    "+menu-anims"
    "/floatbar:sticky:off,default:visible,show:fullscreen"
  )
  [[ -z $rdp_scale ]] || rdp_args+=("$rdp_scale")

  printf '%s\n' "${rdp_args[@]}" | xfreerdp3 /args-from:stdin

  if [[ $keep_alive == false ]]; then
    printf 'RDP session closed. Stopping Windows VM...\n'
    "$omarchy_windows_vm" stop
    printf 'Windows VM stopped.\n'
  else
    printf 'RDP session closed. Windows VM is still running.\n'
    printf 'To stop it: %s stop\n' "$omarchy_windows_vm"
  fi
}

case "${1:-launch}" in
  launch|start)
    shift || true
    launch_windows "${1:-}"
    ;;
  -h|--help|help)
    usage
    ;;
  *)
    usage >&2
    exit 1
    ;;
esac
