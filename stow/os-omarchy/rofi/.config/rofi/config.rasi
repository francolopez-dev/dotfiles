/* Rofi personal configuration.
 * On Omarchy, this supplements or overrides the default theme.
 * To import Omarchy's base theme first:
 *   @import "/usr/share/omarchy/rofi/config.rasi"
 */

configuration {
  show-icons: true;
  terminal: "ghostty";
  /* font: "JetBrains Mono 13"; */
}

