[Unit]
Description=KDE Connect daemon (clipboard sync companion)
Documentation=https://kdeconnect.kde.org/
# Clipboard access needs the live Wayland session.
After=graphical-session.target
BindsTo=graphical-session.target

[Service]
ExecStart=/usr/bin/kdeconnectd --replace
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical-session.target
