#!/usr/bin/env bash
set -euo pipefail

window_json=$(hyprctl activewindow -j)
class=$(jq -r '.class // empty' <<<"$window_json")
title=$(jq -r '.title // empty' <<<"$window_json")
address=$(jq -r '.address // empty' <<<"$window_json")

if [ -z "$class" ] || [ -z "$address" ]; then
  exit 0
fi

close_window() {
  hyprctl dispatch "hl.dsp.window.close({window=\"address:$1\"})"
}

send_shortcut() {
  local mods="$1" key="$2"
  hyprctl dispatch "hl.dsp.send_key_state({mods=\"$mods\",key=\"$key\",state=\"down\"})"
  sleep 0.05
  hyprctl dispatch "hl.dsp.send_key_state({mods=\"$mods\",key=\"$key\",state=\"up\"})"
}

case "$class" in
  xfreerdp)
    if [[ "$title" == "Windows VM - Omarchy" ]]; then
      notify-send "Windows VM protected" "Use the Windows Start menu to shut down." -t 4000 2>/dev/null || true
      exit 0
    fi
    close_window "$address"
    ;;
  com.mitchellh.ghostty)
    send_shortcut SUPER W
    ;;
  Alacritty)
    close_window "$address"
    ;;
  *)
    close_window "$address"
    ;;
esac
