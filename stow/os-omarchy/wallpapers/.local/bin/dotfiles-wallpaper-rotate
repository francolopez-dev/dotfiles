#!/usr/bin/env bash
set -euo pipefail

CONFIG_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/dotfiles/wallpapers.conf"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/dotfiles"
LAST_FILE="$STATE_DIR/wallpaper-rotate.last"
PREVIOUS_FILE="$STATE_DIR/wallpaper-rotate.previous"
CURRENT_BACKGROUND_LINK="$HOME/.config/omarchy/current/background"

WALLPAPER_ROTATION_ENABLED=1
WALLPAPER_ROTATION_INTERVAL="15m"
WALLPAPER_REPO_DIR="$HOME/.config/omarchy/backgrounds/tokyo-night"
WALLPAPER_LOCAL_DIR="$HOME/Pictures/Wallpapers/local"

load_config() {
  if [[ -r "$CONFIG_FILE" ]]; then
    # shellcheck disable=SC1090
    . "$CONFIG_FILE"
  fi
}

interval_seconds() {
  local value="$1" number unit
  if [[ "$value" =~ ^([0-9]+)([smhd]?)$ ]]; then
    number="${BASH_REMATCH[1]}"
    unit="${BASH_REMATCH[2]:-s}"
    case "$unit" in
      s) printf '%s\n' "$number" ;;
      m) printf '%s\n' "$((number * 60))" ;;
      h) printf '%s\n' "$((number * 3600))" ;;
      d) printf '%s\n' "$((number * 86400))" ;;
    esac
  else
    printf '%s\n' 900
  fi
}

ensure_dirs() {
  mkdir -p "$WALLPAPER_LOCAL_DIR" "$STATE_DIR"
}

wallpaper_files() {
  find -L "$WALLPAPER_REPO_DIR" "$WALLPAPER_LOCAL_DIR" \
    -maxdepth 1 -type f \
    \( -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.png' -o -iname '*.webp' \) \
    -print 2>/dev/null || true
}

valid_wallpapers() {
  local file
  while IFS= read -r file; do
    [[ -f "$file" && -s "$file" ]] || continue
    if command -v magick >/dev/null 2>&1; then
      magick identify -quiet "$file" >/dev/null 2>&1 || continue
    elif command -v identify >/dev/null 2>&1; then
      identify -quiet "$file" >/dev/null 2>&1 || continue
    fi
    printf '%s\n' "$file"
  done < <(wallpaper_files)
}

count_wallpapers_in() {
  local dir="$1" count=0 file
  while IFS= read -r file; do
    [[ -n "$file" ]] || continue
    count=$((count + 1))
  done < <(find -L "$dir" -maxdepth 1 -type f \( -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.png' -o -iname '*.webp' \) -print 2>/dev/null || true)
  printf '%s\n' "$count"
}

choose_wallpaper() {
  local previous="" previous_real="" current="" current_real="" choice_count=0 choice line line_real
  local -a choices=()
  [[ -r "$PREVIOUS_FILE" ]] && previous="$(<"$PREVIOUS_FILE")"
  [[ -n "$previous" ]] && previous_real="$(readlink -f "$previous" 2>/dev/null || true)"
  [[ -L "$CURRENT_BACKGROUND_LINK" ]] && current="$(readlink "$CURRENT_BACKGROUND_LINK")"
  [[ -n "$current" ]] && current_real="$(readlink -f "$current" 2>/dev/null || true)"
  mapfile -t choices < <(valid_wallpapers)
  choice_count="${#choices[@]}"
  [[ "$choice_count" -gt 0 ]] || return 1

  if [[ "$choice_count" -eq 1 ]]; then
    printf '%s\n' "${choices[0]}"
    return 0
  fi

  while IFS= read -r line; do
    line_real="$(readlink -f "$line" 2>/dev/null || true)"
    [[ -z "$previous_real" || "$line_real" != "$previous_real" ]] || continue
    [[ -z "$current_real" || "$line_real" != "$current_real" ]] || continue
    choice="$line"
    break
  done < <(printf '%s\n' "${choices[@]}" | shuf)
  printf '%s\n' "${choice:-${choices[0]}}"
}

start_swaybg() {
  local background_link="$1"
  if command -v uwsm-app >/dev/null 2>&1; then
    setsid uwsm-app -- swaybg -i "$background_link" -m fill >/dev/null 2>&1 &
  else
    setsid swaybg -i "$background_link" -m fill >/dev/null 2>&1 &
  fi
}

set_wallpaper() {
  local selected="$1" old_background=""
  [[ -L "$CURRENT_BACKGROUND_LINK" ]] && old_background="$(readlink "$CURRENT_BACKGROUND_LINK")"

  ln -nsf "$selected" "$CURRENT_BACKGROUND_LINK"
  pkill -x swaybg >/dev/null 2>&1 || true
  start_swaybg "$CURRENT_BACKGROUND_LINK"
  sleep 0.5

  if pgrep -x swaybg >/dev/null 2>&1; then
    return 0
  fi

  # Restore the previous wallpaper rather than leaving a black background.
  if [[ -n "$old_background" && -f "$old_background" ]]; then
    ln -nsf "$old_background" "$CURRENT_BACKGROUND_LINK"
    start_swaybg "$CURRENT_BACKGROUND_LINK"
    sleep 0.5
  fi

  if pgrep -x swaybg >/dev/null 2>&1; then
    printf 'Failed to start selected wallpaper, restored previous background: %s\n' "$old_background" >&2
  else
    printf 'Failed to start swaybg for wallpaper: %s\n' "$selected" >&2
  fi
  return 1
}

rotate_wallpaper() {
  local force="${1:-0}" now last=0 interval selected
  load_config
  ensure_dirs

  if [[ "$WALLPAPER_ROTATION_ENABLED" != "1" && "$force" != "1" ]]; then
    return 0
  fi

  now="$(date +%s)"
  [[ -r "$LAST_FILE" ]] && last="$(<"$LAST_FILE")"
  interval="$(interval_seconds "$WALLPAPER_ROTATION_INTERVAL")"
  if [[ "$force" != "1" && $((now - last)) -lt "$interval" ]]; then
    return 0
  fi

  selected="$(choose_wallpaper || true)"
  if [[ -z "$selected" ]]; then
    printf 'No valid wallpapers found in:\n  %s\n  %s\n' "$WALLPAPER_REPO_DIR" "$WALLPAPER_LOCAL_DIR" >&2
    return 0
  fi

  set_wallpaper "$selected"

  printf '%s\n' "$now" >"$LAST_FILE"
  printf '%s\n' "$selected" >"$PREVIOUS_FILE"
  printf 'Rotated wallpaper: %s\n' "$selected"
}

status_wallpaper() {
  local current="" timer="unknown"
  load_config
  ensure_dirs
  [[ -L "$CURRENT_BACKGROUND_LINK" ]] && current="$(readlink "$CURRENT_BACKGROUND_LINK")"
  if command -v systemctl >/dev/null 2>&1; then
    timer="$(systemctl --user is-active dotfiles-wallpaper-rotate.timer 2>/dev/null || true)"
  fi
  printf 'enabled: %s\n' "$WALLPAPER_ROTATION_ENABLED"
  printf 'interval: %s\n' "$WALLPAPER_ROTATION_INTERVAL"
  printf 'timer: %s\n' "${timer:-unknown}"
  printf 'repo_dir: %s\n' "$WALLPAPER_REPO_DIR"
  printf 'repo_wallpapers: %s\n' "$(count_wallpapers_in "$WALLPAPER_REPO_DIR")"
  printf 'local_dir: %s\n' "$WALLPAPER_LOCAL_DIR"
  printf 'local_wallpapers: %s\n' "$(count_wallpapers_in "$WALLPAPER_LOCAL_DIR")"
  printf 'current: %s\n' "${current:-unknown}"
}

open_local() {
  load_config
  ensure_dirs
  if command -v xdg-open >/dev/null 2>&1; then
    xdg-open "$WALLPAPER_LOCAL_DIR" >/dev/null 2>&1 &
  elif command -v nautilus >/dev/null 2>&1; then
    nautilus "$WALLPAPER_LOCAL_DIR" >/dev/null 2>&1 &
  else
    printf '%s\n' "$WALLPAPER_LOCAL_DIR"
  fi
}

case "${1:-rotate}" in
  rotate)
    if [[ "${2:-}" == "--force" ]]; then
      rotate_wallpaper 1
    else
      rotate_wallpaper 0
    fi
    ;;
  status) status_wallpaper ;;
  ensure) load_config; ensure_dirs ;;
  open-local) open_local ;;
  *) printf 'Usage: dotfiles-wallpaper-rotate [rotate [--force]|status|ensure|open-local]\n' >&2; exit 2 ;;
esac
