<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.dotfiles.wallpaper</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>-lc</string>
    <string>mkdir -p "$HOME/Library/Logs/dotfiles"; exec "$HOME/.local/bin/dotfiles-wallpaper" rotate >>"$HOME/Library/Logs/dotfiles/wallpaper.out.log" 2>>"$HOME/Library/Logs/dotfiles/wallpaper.err.log"</string>
  </array>
  <!-- Tick faster than the rotation interval; the engine gates on
       WALLPAPER_ROTATION_INTERVAL itself, so a 5-minute tick gives
       on-time rotations without double-rotating. -->
  <key>StartInterval</key>
  <integer>300</integer>
  <key>RunAtLoad</key>
  <true/>
</dict>
</plist>
