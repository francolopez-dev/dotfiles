#!/usr/bin/env bash
# Apply the Git-managed SDDM presentation while keeping Omarchy's login stack.
#
# This does not change display managers, sessions, or SDDM's theme name.
# It copies Omarchy's stock theme assets, then overlays the QML/config files
# managed in this repo under ~/.config/dotfiles/sddm/omarchy/.
set -euo pipefail

custom_theme="$HOME/.config/dotfiles/sddm/omarchy"
omarchy_theme="${OMARCHY_PATH:-$HOME/.local/share/omarchy}/default/sddm/omarchy"
target_theme="/usr/share/sddm/themes/omarchy"
sddm_autologin="/etc/sddm.conf.d/autologin.conf"

if [[ -f "$sddm_autologin" ]]; then
  if ! grep -qx 'Session=omarchy' "$sddm_autologin"; then
    printf 'warning: SDDM is not configured for Session=omarchy; not changing it.\n' >&2
  fi
  if ! grep -qx 'Current=omarchy' "$sddm_autologin"; then
    printf 'warning: SDDM is not configured for Current=omarchy; not changing it.\n' >&2
  fi
fi

if [[ ! -d "$custom_theme" ]]; then
  printf 'dotfiles SDDM theme not found: %s\n' "$custom_theme" >&2
  exit 1
fi

if [[ -d "$omarchy_theme" ]]; then
  sudo rm -rf "$target_theme"
  sudo mkdir -p "$(dirname "$target_theme")"
  sudo cp -R "$omarchy_theme" "$target_theme"
else
  sudo mkdir -p "$target_theme"
fi

sudo cp -R "$custom_theme"/. "$target_theme"/
sudo chmod -R a+rX "$target_theme"

printf 'Applied Git-managed Omarchy SDDM theme: %s\n' "$target_theme"
