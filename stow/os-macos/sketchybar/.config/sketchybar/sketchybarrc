#!/bin/bash

# Managed by dotfiles. Start with: brew services start sketchybar

CONFIG_DIR="${HOME}/.config/sketchybar"
PLUGIN_DIR="${CONFIG_DIR}/plugins"

# shellcheck source=/dev/null
. "${CONFIG_DIR}/colors.sh"

FONT="JetBrainsMono Nerd Font"
HEIGHT=28

sketchybar --bar \
  position=top \
  height="${HEIGHT}" \
  color="${BAR_BG}" \
  blur_radius=20 \
  padding_left=8 \
  padding_right=8 \
  margin=0 \
  y_offset=0 \
  sticky=on \
  topmost=window

sketchybar --default \
  updates=when_shown \
  icon.font="${FONT}:Regular:15.0" \
  icon.color="${TEXT_SOFT}" \
  icon.padding_left=5 \
  icon.padding_right=5 \
  label.font="${FONT}:Regular:12.0" \
  label.color="${TEXT}" \
  label.padding_left=5 \
  label.padding_right=5 \
  background.drawing=off \
  padding_left=0 \
  padding_right=0

sketchybar --remove '/.*/' >/dev/null 2>&1
sketchybar --add event aerospace_workspace_change
sketchybar --add event spotify_change com.spotify.client.PlaybackStateChanged

# AeroSpace launches in parallel at login. The workspace list below is static,
# but the initial focused state still benefits from a bounded CLI wait.
if command -v aerospace >/dev/null 2>&1; then
  aerospace_tries=0
  until aerospace list-workspaces --all >/dev/null 2>&1; do
    aerospace_tries=$((aerospace_tries + 1))
    [ "${aerospace_tries}" -ge 30 ] && break
    sleep 0.5
  done
fi

workspaces=(one two three four five six seven)
workspace_index=0
for workspace in "${workspaces[@]}"; do
  workspace_index=$((workspace_index + 1))
  item="workspace.${workspace}"
  default_color="${BLUE}"
  if [ $((workspace_index % 2)) -eq 1 ]; then
    default_color="${PURPLE}"
  fi

  sketchybar --add item "${item}" left \
    --set "${item}" \
      icon="" \
      icon.color="${default_color}" \
      icon.highlight_color="${CYAN}" \
      label.drawing=off \
      click_script="focused=\$(aerospace list-workspaces --focused 2>/dev/null || true); [ \"\$focused\" = '${workspace}' ] || aerospace workspace '${workspace}' >/dev/null 2>&1" \
      script="${PLUGIN_DIR}/aerospace.sh" \
    --subscribe "${item}" aerospace_workspace_change
done

sketchybar --add item front_app left \
  --set front_app \
    icon.drawing=off \
    label.color="${TEXT_SOFT}" \
    label.max_chars=36 \
    background.drawing=on \
    background.color="${SURFACE}" \
    background.corner_radius=999 \
    background.height=20 \
    padding_left=4 \
    padding_right=2 \
    script="${PLUGIN_DIR}/front_app.sh" \
  --subscribe front_app front_app_switched

# Position "e" anchors right of the camera notch on the built-in display
# (plain center would hide behind it); on external monitors it starts at the
# center line.
sketchybar --add item media e \
  --set media \
    icon.color="${GREEN}" \
    label.color="${TEXT}" \
    label.max_chars=56 \
    background.drawing=on \
    background.color="${SURFACE}" \
    background.corner_radius=999 \
    background.height=22 \
    padding_left=6 \
    padding_right=6 \
    update_freq=10 \
    script="${PLUGIN_DIR}/media.sh" \
  --subscribe media spotify_change system_woke

# Right items stack right-to-left (first added = rightmost). Desired visual
# order, left to right: wifi, vpn, volume, battery, memory, cpu, date, time.
sketchybar --add item clock right \
  --set clock \
    icon.drawing=off \
    label.color="${TEXT}" \
    label.font="${FONT}:Bold:12.0" \
    update_freq=10 \
    script="${PLUGIN_DIR}/clock.sh" \
    click_script="open -a Calendar" \
  --subscribe clock system_woke

sketchybar --add item date right \
  --set date \
    icon.drawing=off \
    label.color="${TEXT_SOFT}" \
    label.font="${FONT}:Bold:12.0" \
    update_freq=60 \
    script="${PLUGIN_DIR}/clock.sh" \
    click_script="open -a Calendar" \
  --subscribe date system_woke

sketchybar --add item cpu right \
  --set cpu \
    update_freq=3 \
    script="${PLUGIN_DIR}/cpu.sh" \
    click_script='open -na Ghostty --args -e btop || open -a Ghostty' \
  --add item memory right \
  --set memory \
    update_freq=5 \
    script="${PLUGIN_DIR}/memory.sh" \
    click_script='open -na Ghostty --args -e btop || open -a Ghostty' \
  --add item battery right \
  --set battery \
    update_freq=5 \
    script="${PLUGIN_DIR}/battery.sh" \
  --add item volume right \
  --set volume \
    script="${PLUGIN_DIR}/volume.sh" \
    click_script="osascript -e 'set volume output muted not (output muted of (get volume settings))'" \
  --subscribe volume volume_change \
  --add item vpn right \
  --set vpn \
    update_freq=10 \
    script="${PLUGIN_DIR}/vpn.sh" \
  --add item wifi right \
  --set wifi \
    update_freq=10 \
    script="${PLUGIN_DIR}/wifi.sh" \
    click_script="open x-apple.systempreferences:com.apple.wifi-settings-extension" \
  --subscribe wifi wifi_change system_woke

sketchybar --trigger aerospace_workspace_change \
  FOCUSED_WORKSPACE="$(aerospace list-workspaces --focused 2>/dev/null || true)"

sketchybar --update
