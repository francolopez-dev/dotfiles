# Ghostty - global terminal config tracked by dotfiles.
# Shared across every machine. Put font-size overrides in profiles.

# --- Theme ---
background = #100d1f
foreground = #ffffff
selection-background = #3a245e
selection-foreground = #ffffff
minimum-contrast = 1.2
palette = 0=#201830
palette = 1=#ff5c8a
palette = 2=#7ef7b6
palette = 3=#ffd166
palette = 4=#8aa8ff
palette = 5=#c77dff
palette = 6=#56f0e5
palette = 7=#ffffff
palette = 8=#4b3c64
palette = 9=#ff7aa8
palette = 10=#9dffd0
palette = 11=#ffe08a
palette = 12=#a7bcff
palette = 13=#d89cff
palette = 14=#7ff7ef
palette = 15=#ffffff
palette-generate = false

# --- Font ---
font-family = JetBrains Mono
font-family = FiraCode Nerd Font
font-thicken = false
font-feature = -calt

# --- Window ---
gtk-wide-tabs = false
gtk-toolbar-style = flat
gtk-titlebar-style = native
window-show-tab-bar = auto
gtk-custom-css = ?~/.config/ghostty/gtk.css
window-padding-x = 18
window-padding-y = 14
background-opacity = 0.92
background-blur = true
custom-shader = ?~/.config/ghostty/shaders/cursor_sweep.glsl
custom-shader-animation = true
# Ghostty 1.3.1 does not expose background-blur-radius; do not add it here.
background-opacity-cells = true
unfocused-split-opacity = 0.9
window-decoration = false

# --- Behavior ---
scrollback-limit = 10000
confirm-close-surface = true
shell-integration = detect
# ssh-terminfo installs xterm-ghostty on remote hosts via infocmp|tic (cached);
# ssh-env falls back to TERM=xterm-256color when that install fails. Without
# these, SSH to hosts lacking the terminfo breaks zle redraw and full-screen
# apps (nano ignores Ctrl-X). Both need Ghostty >= 1.2.
shell-integration-features = cursor,sudo,title,ssh-env,ssh-terminfo
mouse-hide-while-typing = true
cursor-click-to-move = true
selection-clear-on-copy = true
# macos-option-as-alt is macOS-specific; keep it out of the Linux/Omarchy
# global config until a macOS layer exists.

# --- Cursor ---
cursor-style = block
cursor-style-blink = false
cursor-color = #7ef7b6
cursor-text = #100d1f
adjust-cursor-thickness = 35%

# --- Keybinds (Super = Win/macOS Command on Omarchy/Hyprland) ---
keybind = super+c=copy_to_clipboard
keybind = super+v=paste_from_clipboard
keybind = super+a=select_all
keybind = super+t=new_tab
keybind = super+w=close_tab:this
keybind = super+q=quit
keybind = ctrl+tab=next_tab
keybind = ctrl+shift+tab=previous_tab

# Optional profile layer override. This is where machine font sizes live.
config-file = ?~/.config/ghostty/profile-overrides
