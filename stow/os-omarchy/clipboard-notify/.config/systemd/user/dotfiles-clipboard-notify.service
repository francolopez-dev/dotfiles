[Unit]
Description=Clipboard ready notification watcher
Documentation=man:wl-paste(1)
# Wayland clipboard access needs the live desktop session.
After=graphical-session.target
BindsTo=graphical-session.target

[Service]
ExecStart=%h/.local/bin/dotfiles-clipboard-notify watch
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical-session.target
